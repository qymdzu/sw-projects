# 智能学习软件 — 调试环境变量模板
# 复制此文件为 .env 并根据需要修改
# cp deploy/config/development/.env.example deploy/config/development/.env

# ─── 服务端口映射 ──────────────────────────────────
# 后端 API 映射到宿主机端口（默认 8081，避免与 8080 冲突）
API_PORT=8081

# 前端 Web 映射到宿主机端口
WEB_PORT=8080

# 数据库映射到宿主机端口
DB_PORT=5432

# Delve 调试端口（仅调试版暴露）
DEBUG_PORT=2345

# ─── 数据库配置 ────────────────────────────────────
DB_USER=smart_learning
DB_PASSWORD=smart_learning
DB_NAME=smart_learning

# ─── JWT 配置 ──────────────────────────────────────
# ⚠️ 生产环境必须替换为 32 位以上随机字符串
JWT_SECRET=dev-secret-please-replace-in-production
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=168h

# ─── 日志配置 ──────────────────────────────────────
# 可选：debug / info / warn / error
LOG_LEVEL=debug
SERVER_MODE=debug
APP_ENV=dev

# ─── CORS 白名单 ───────────────────────────────────
# 允许多个来源，用逗号分隔
CORS_ALLOW_ORIGINS=http://localhost:8080,http://localhost:5173