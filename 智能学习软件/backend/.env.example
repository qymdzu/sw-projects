# 服务
SERVER_PORT=8080
SERVER_MODE=debug
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=30s

# 数据库（PostgreSQL）
DB_HOST=localhost
DB_PORT=5432
